PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/web-clinic
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Optional SMTP for OTP and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Web Clinic <no-reply@webclinic.local>

# Cloudinary (falls back to local /uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Khalti: add the merchant secret key locally. Do not commit a real key.
# Use dev.khalti.com for sandbox testing; switch to https://khalti.com/api/v2 for production.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# eSewa ePay V2: use the merchant values supplied by eSewa. Do not commit a real key.
# Leave ESEWA_ENVIRONMENT as uat for testing; set it to live only with production credentials.
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_ENVIRONMENT=uat
# Public URL where this API is reachable by eSewa (required outside local development).
API_URL=http://localhost:5000
# Optional overrides for post-payment routing.
ESEWA_SUCCESS_URL=
ESEWA_FAILURE_URL=
